ITEM_STATUS, ITEM_SYNC, ITEM_OPEN = 1, 3, 4

# KWin script: bring the Panel-Sync window to the current desktop and activate it
RAISE_JS = """\
const w = workspace.windowList().find(w => w.caption === "Panel-Sync"
    && (w.resourceClass.indexOf("qml") >= 0 || w.desktopFileName === "plasma-panel-sync"));
if (w) {
    w.minimized = false;
    w.desktops = [workspace.currentDesktop];
    workspace.activeWindow = w;
}
"""

# Constant SNI properties, built once as variants
SNI_STATIC = {
    k: GLib.Variant(t, v)
    for k, (t, v) in {
        "Category": ("s", "ApplicationStatus"),
        "Id": ("s", "panel-sync"),
        "Title": ("s", "Panel-Sync"),
        "WindowId": ("i", 0),
        "IconName": ("s", ""),
        "OverlayIconName": ("s", ""),
        "AttentionIconName": ("s", ""),
        "ItemIsMenu": ("b", False),
        "Menu": ("o", "/MenuBar"),
    }.items()
}


def pixmaps(path):
    """Render the SVG as ARGB32 pixmaps (network byte order) in several sizes."""
    out = []
    for size in (16, 22, 32, 48, 64):
        pb = GdkPixbuf.Pixbuf.new_from_file_at_size(str(path), size, size)
        w, h, stride, n = pb.get_width(), pb.get_height(), pb.get_rowstride(), pb.get_n_channels()
        px = pb.get_pixels()
        argb = bytearray()
        for y in range(h):
            row = px[y * stride : y * stride + w * n]
            for x in range(w):
                r, g, b = row[x * n : x * n + 3]
                a = row[x * n + 3] if n == 4 else 255
                argb += bytes((a, r, g, b))
        out.append((w, h, bytes(argb)))
    return out


class Tray:
    def __init__(self):
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        self.name = f"org.kde.StatusNotifierItem-{os.getpid()}-1"
        # Build the pixmaps once as ready variants — Plasma reads the properties
        # very often (per systray instance); converting cost ~135 ms per query
        self.icon = GLib.Variant("a(iiay)", pixmaps(ICON))
        self.icon_attention = GLib.Variant("a(iiay)", pixmaps(ICON_ATTENTION))
        self.status_text = "Loading …"
        self.details = []  # changes since the last sync (for the tooltip)
        self.needs_sync = False
        self.auto_source = None  # (screen, name)
        self.busy = False
        self.revision = 1

        sni = Gio.DBusNodeInfo.new_for_xml(SNI_XML).interfaces[0]
        menu = Gio.DBusNodeInfo.new_for_xml(MENU_XML).interfaces[0]
        self.bus.register_object("/StatusNotifierItem", sni, self.sni_call, self.sni_prop, None)
        self.bus.register_object("/MenuBar", menu, self.menu_call, self.menu_prop, None)
        Gio.bus_own_name_on_connection(self.bus, self.name, Gio.BusNameOwnerFlags.NONE, None, None)
        # the watcher (kded) can restart → register again then
        Gio.bus_watch_name_on_connection(
            self.bus,
            "org.kde.StatusNotifierWatcher",
            Gio.BusNameWatcherFlags.NONE,
            self.register,
            None,
        )

        self.monitors = []
        for f in (pps.APPLETSRC, pps.SHELLRC):
            # watch the directory: Plasma replaces the files atomically
            m = Gio.File.new_for_path(str(f.parent)).monitor_directory(
                Gio.FileMonitorFlags.WATCH_MOVES, None
            )
            m.connect("changed", self.on_file_changed)
            self.monitors.append(m)
        self.pending = None
        self.check()
        GLib.timeout_add_seconds(60, self.check)  # safety net

    # --- Registration --------------------------------------------------------
    def register(self, *_):
        self.bus.call(
            "org.kde.StatusNotifierWatcher",
            "/StatusNotifierWatcher",
            "org.kde.StatusNotifierWatcher",
            "RegisterStatusNotifierItem",
            GLib.Variant("(s)", (self.name,)),
            None,
            Gio.DBusCallFlags.NONE,
            -1,
            None,
            None,
        )

    # --- State -----------------------------------------------------------------
    def on_file_changed(self, _mon, file, other, _event):
        names = {file.get_basename(), other.get_basename() if other else None}
        if names & {pps.APPLETSRC.name, pps.SHELLRC.name}:
            if self.pending:
                GLib.source_remove(self.pending)
            self.pending = GLib.timeout_add(800, self.check_once)  # batch writes

    def check_once(self):
        """Single batched check after file changes (the timer must not repeat)."""
        self.pending = None
        self.check()
        return False

    def check(self):
        if self.busy:
            return True
        details = []
        try:
            rc, shell = pps.KConfig(pps.APPLETSRC), pps.KConfig(pps.SHELLRC)
            names = pps.screens()
            a = pps.analyze(rc, shell, pps.panels(rc))
            needs = a.needs_sync
            if a.auto_source is not None:
                self.auto_source = (a.auto_source, names.get(a.auto_source, str(a.auto_source)))
                text = f"Changed on {self.auto_source[1]}"
                for loc, g in a.groups.items():
                    if g["source"]:
                        details += [
                            l.strip()
                            for l in pps.diff(  # noqa: E741
                                a.snapshot["groups"][str(loc)]["layout"],
                                pps.fingerprint(rc, shell, g["source"])[1],
                            )
                        ]
            else:
                self.auto_source = None
                text = (
                    "Never synced – choose the source in the window"
                    if a.nosnap
                    else "Panels changed on several screens"
                    if needs
                    else "All panels in sync"
                )
        except Exception as e:  # never crash, just show it
            needs, text = True, f"Error: {e}"
            self.auto_source = None
        self.update(needs, text, details)
        return True

    def update(self, needs, text, details=None):
        details = self.details if details is None else details
        status_changed = needs != self.needs_sync
        text_changed = text != self.status_text or details != self.details
        self.needs_sync, self.status_text, self.details = needs, text, details
        if status_changed:
            self.emit(
                "/StatusNotifierItem",
                "org.kde.StatusNotifierItem",
                "NewStatus",
                GLib.Variant("(s)", (self.status(),)),
            )
            self.emit("/StatusNotifierItem", "org.kde.StatusNotifierItem", "NewIcon", None)
        if status_changed or text_changed:
            self.emit("/StatusNotifierItem", "org.kde.StatusNotifierItem", "NewToolTip", None)
            self.revision += 1
            self.emit(
                "/MenuBar",
                "com.canonical.dbusmenu",
                "LayoutUpdated",
                GLib.Variant("(ui)", (self.revision, 0)),
            )

    def tooltip(self):
        """Tooltip text (Plasma renders it as rich text)."""
        body = html.escape(self.status_text)
        if self.details:
            body += "<br><br>Changes since last sync:<br>" + "<br>".join(
                map(html.escape, self.details)
            )
        return body

    def status(self):
        return "Active" if (self.needs_sync or self.busy) else "Passive"

    def emit(self, path, iface, signal, params):
        self.bus.emit_signal(None, path, iface, signal, params)

    # --- Actions -----------------------------------------------------------------
    def open_window(self):
        subprocess.Popen(
            [str(UI)],
            start_new_session=True,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        # On Wayland a window may not raise itself — KWin may.
        # Wait briefly until a newly started window exists.
        GLib.timeout_add(150, self.raise_window)
        GLib.timeout_add(900, self.raise_window)

    def raise_window(self):
        script = pps.STATE / "raise-window.js"
        if not script.exists() or script.read_text() != RAISE_JS:
            pps.STATE.mkdir(parents=True, exist_ok=True)
            script.write_text(RAISE_JS)
        name = f"panel-sync-raise-{os.getpid()}"

        def call(path, method, params, reply, cb=None):
            self.bus.call(
                "org.kde.KWin",
                path,
                "org.kde.kwin.Scripting" if path == "/Scripting" else "org.kde.kwin.Script",
                method,
                params,
                reply,
                Gio.DBusCallFlags.NONE,
                3000,
                None,
                (lambda b, r: cb(b.call_finish(r))) if cb else None,
            )

        def loaded(res):
            sid = res.unpack()[0]
            if sid < 0:
                return
            call(f"/Scripting/Script{sid}", "run", None, None)
            GLib.timeout_add(
                500,
                lambda: (
                    call("/Scripting", "unloadScript", GLib.Variant("(s)", (name,)), None) and False
                ),
            )

        def start(_res=None):
            call(
                "/Scripting",
                "loadScript",
                GLib.Variant("(ss)", (str(script), name)),
                GLib.VariantType("(i)"),
                lambda r: loaded(r),  # noqa: PLW0108
            )

        # first unload a possibly stuck script of the same name
        self.bus.call(
            "org.kde.KWin",
            "/Scripting",
            "org.kde.kwin.Scripting",
            "unloadScript",
            GLib.Variant("(s)", (name,)),
            None,
            Gio.DBusCallFlags.NONE,
            3000,
            None,
            lambda b, r: (self._finish(b, r), start()),
        )
        return False

    @staticmethod
    def _finish(bus, res):
        try:  # noqa: SIM105
            bus.call_finish(res)
        except GLib.Error:
            pass

    def sync(self):
        if self.busy or not self.auto_source:
            self.open_window()
            return
        self.busy = True
        self.update(self.needs_sync, f"Syncing from {self.auto_source[1]} …")
        pid, *_ = GLib.spawn_async(
            [str(SYNC), "sync", "--from", str(self.auto_source[0])],
            flags=GLib.SpawnFlags.DO_NOT_REAP_CHILD,
        )

        def done(_pid, _status):
            GLib.spawn_close_pid(_pid)
            self.busy = False
            self.check()

        GLib.child_watch_add(GLib.PRIORITY_DEFAULT, pid, done)

    # --- StatusNotifierItem ----------------------------------------------------------
    def sni_prop(self, _c, _s, _p, _i, prop):
        if prop == "IconPixmap":
            return self.icon_attention if self.needs_sync else self.icon
        if prop == "AttentionIconPixmap":
            return self.icon_attention
        if prop == "Status":
            return GLib.Variant("s", self.status())
        if prop == "ToolTip":
            return GLib.Variant("(sa(iiay)ss)", ("", [], "Panel-Sync", self.tooltip()))
        return SNI_STATIC.get(prop)

    def sni_call(self, _c, _s, _p, _i, method, _params, inv):
        if method == "Activate":
            self.open_window()
        elif method == "SecondaryActivate":  # noqa: SIM102
            # middle click: sync directly (if the source is unclear, sync() opens the window)
            if self.needs_sync and not self.busy:
                self.sync()
        inv.return_value(None)

    # --- DBusMenu ------------------------------------------------------------------
    def items(self):
        sync_label = f"Sync now (from {self.auto_source[1]})" if self.auto_source else "Sync …"
        return {
            ITEM_STATUS: {
                "label": GLib.Variant("s", self.status_text),
                "enabled": GLib.Variant("b", False),
            },
            2: {"type": GLib.Variant("s", "separator")},
            ITEM_SYNC: {
                "label": GLib.Variant("s", sync_label),
                "icon-name": GLib.Variant("s", "view-refresh"),
                "enabled": GLib.Variant("b", self.needs_sync and not self.busy),
            },
            ITEM_OPEN: {
                "label": GLib.Variant("s", "Open window"),
                "icon-name": GLib.Variant("s", "window"),
            },
        }

    def layout(self):
        children = [GLib.Variant("(ia{sv}av)", (i, props, [])) for i, props in self.items().items()]
        return (0, {"children-display": GLib.Variant("s", "submenu")}, children)

    def menu_call(self, _c, _s, _p, _i, method, params, inv):
        if method == "GetLayout":
            inv.return_value(GLib.Variant("(u(ia{sv}av))", (self.revision, self.layout())))
        elif method == "GetGroupProperties":
            ids = params.unpack()[0]
            items = self.items()
            res = [(i, items[i]) for i in (ids or items.keys()) if i in items]
            inv.return_value(GLib.Variant("(a(ia{sv}))", (res,)))
        elif method == "GetProperty":
            i, name = params.unpack()
            v = self.items().get(i, {}).get(name, GLib.Variant("s", ""))
            inv.return_value(GLib.Variant("(v)", (v,)))
        elif method == "Event":
            i, event = params.unpack()[:2]
            inv.return_value(None)
            if event == "clicked":
                if i == ITEM_SYNC:
                    self.sync()
                elif i == ITEM_OPEN:
                    self.open_window()
        elif method == "EventGroup":
            for i, event, *_ in params.unpack()[0]:
                if event == "clicked":
                    GLib.idle_add(
                        lambda i=i: (
                            (
                                self.sync()
                                if i == ITEM_SYNC
                                else self.open_window()
                                if i == ITEM_OPEN
                                else None
                            )
                            and False
                        )
                    )
            inv.return_value(GLib.Variant("(ai)", ([],)))
        elif method == "AboutToShow":
            self.check()
            inv.return_value(GLib.Variant("(b)", (False,)))
        elif method == "AboutToShowGroup":
            self.check()
            inv.return_value(GLib.Variant("(aiai)", ([], [])))
        else:
            inv.return_value(None)

    def menu_prop(self, _c, _s, _p, _i, prop):
        return {
            "Version": GLib.Variant("u", 3),
            "TextDirection": GLib.Variant("s", "ltr"),
            "Status": GLib.Variant("s", "normal"),
            "IconThemePath": GLib.Variant("as", []),
        }.get(prop)


def main():
    # single instance: fixed bus name, DO_NOT_QUEUE (4) → 1 = we are the owner
    bus = Gio.bus_get_sync(Gio.BusType.SESSION)
    r = bus.call_sync(
        "org.freedesktop.DBus",
        "/org/freedesktop/DBus",
        "org.freedesktop.DBus",
        "RequestName",
        GLib.Variant("(su)", ("io.github.compact161.PanelSyncTray", 4)),
        GLib.VariantType("(u)"),
        Gio.DBusCallFlags.NONE,
        -1,
        None,
    )
    if r.unpack()[0] != 1:
        sys.exit(0)
    Tray()
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()
